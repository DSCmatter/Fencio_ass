# Copy to .env. Never commit the real .env file.

# Model backend: auto | remote | deterministic
# "deterministic" is an offline rule-based adapter. It runs locally with no model.
# "remote" points at the OpenAI-compatible endpoint served from Colab/Kaggle.
RT_MODEL_BACKEND=deterministic
RT_MODEL_BASE_URL=
RT_MODEL_API_KEY=
RT_MODEL_NAME=qwen2.5-3b-qlora

# Local vulnerable target. LegacyBot on the DVAA default port.
RT_TARGET_URL=http://127.0.0.1:7003
